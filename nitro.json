{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["webrtcplayback"],
  "ios": {
    "iosModuleName": "NitroWebRtcPlayback"
  },
  "android": {
    "androidNamespace": ["webrtcplayback"],
    "androidCxxLibName": "NitroWebRtcPlayback"
  },
  "autolinking": {
    "WebRtcPlayback": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridWebRtcPlayback"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridWebRtcPlayback"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "example"]
}
